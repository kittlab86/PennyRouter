# PennyRouter dev settings — COMMITTED, generic values only (no secrets).
#
# Env layout (three files):
#   .env.example  canonical template: every variable, documented.
#   .env.dev      this file: working dev values (local + server dev stack).
#   .env          gitignored overlay: secrets + custom URLs only. Real values
#                 for BASETEN_API_KEY, MODAL_KEY_ID, MODAL_KEY_SECRET,
#                 RANKINGS_API_KEY, and per-deployment URLs/picks
#                 (MODAL_BASE_URL, MODAL_SCORE_URL, MODAL_MODELS,
#                 BASETEN_MODELS, OPENROUTER_SCORE_MODEL).
#
# Usage:
#   docker compose --env-file .env.dev [--env-file .env] up --build
# (`make dev` does this, adding .env when it exists.) Deploys ship
# .env.dev merged with .env, secrets winning (see scripts/deploy.sh).
# Gateway serving keys never belong in any of these files — they travel
# with each request (see docs/api.md).

# Port the gateway listens on inside the container.
PORT=8080
# Port published on the host for local dev (the proxy-reached server
# stack publishes no ports and ignores this).
HOST_PORT=3000
# Image reference. Dev compose tags its local build with this;
# server compose pulls it from GitHub Packages (ghcr.io).
IMAGE=ghcr.io/lsk242/pennyrouter:latest
# Upstream base URL for POST /v1/chat/completions (Iter 1b).
# Native `/api/v1/…` paths compose against this base minus its trailing
# `/api` (Iter 25), so account/catalog reads reach OpenRouter intact.
OPENROUTER_BASE_URL=https://openrouter.ai/api
# Management writes through the fallback proxy (Iter 25): empty keeps
# them 403 without touching upstream (safe dev default; set to 1 to
# proxy key creation, credit purchases, workspace budget changes).
ALLOW_MANAGEMENT_PROXY=
# Provider-pinned upstreams (Iter 16): `modal/<model>` and
# `baseten/<model>` forward there instead of OpenRouter, with the
# caller's Authorization forwarded unchanged (pure BYOK: no gateway
# keys on the serving path). Unset = that provider's routes fail
# closed with provider_not_configured. Baseten's default is its public
# inference host (no `/v1` prefix — the gateway appends the request
# path itself); Modal has no shared deployment, so MODAL_BASE_URL stays
# in .env until configured. Operator model picks (MODAL_MODELS,
# BASETEN_MODELS) live in .env too — see .env.example.
BASETEN_BASE_URL=https://inference.baseten.co
# Catalog artifact the gateway routes from (Iter 5): directory, manifest,
# or DB file. Empty/unset means plain passthrough without routing.
CATALOG_DB=/catalog
# Upstream concurrency bounds (Iter 9): max simultaneous upstream calls
# and max requests waiting for a slot; beyond both, shed with 503.
UPSTREAM_MAX_CONCURRENT=64
UPSTREAM_MAX_QUEUED=128
# Catalog reload cadence in seconds (Iter 10): 0 disables the background
# reload (load-once behavior).
RELOAD_INTERVAL_SECS=60
# Catalog sync image: local compose tags its build with this; server
# deploys pull it, so it must be a pullable tag (same deal as IMAGE).
CATALOG_IMAGE=ghcr.io/lsk242/pennyrouter-catalog:latest
# Seconds between catalog sync cycles: daily by default (0 = run
# once and exit). Scoring never runs on this loop — on-demand only
# via the catalog-ui run page.
SYNC_INTERVAL=86400
# Catalog input: 1 = live OpenRouter fetch (Iter 18), 0 = baked
# fixtures (offline default). Dev runs live.
FETCH_OPENROUTER=1
# Sync input/output paths (entrypoint defaults, suit the compose mount
# layout — see .env.example; rarely changed).
MODELS=/input/models.json
ENDPOINTS_DIR=/input/endpoints
OUT_DIR=/catalog
TRENDS=/input/trends.json
ASSIST=/input/rank-assist.json
PROMOS=/input/promos.json
# Extra model ids (comma-separated, Iter 24): fetched individually
# even when the models list omits them (e.g. non-text-output scoring
# models like Respan Span, which back the `decision` tier).
EXTRA_MODEL_IDS=respan/span-01-lite:free
# OpenRouter scorer model (Iter 30): empty = openrouter scoring fails
# closed. Set your pick in .env when running catalog-process with
# --score-backend openrouter (key = shared RANKINGS_API_KEY there).
OPENROUTER_SCORE_MODEL=
# Debug UIs (Iter 17): both on for dev. GATEWAY_UI registers
# GET /ui on the gateway (same port); CATALOG_UI lets the catalog-ui
# browser start at all.
GATEWAY_UI=1
CATALOG_UI=1
# Host port for the opt-in catalog-ui compose service
# (docker compose --profile ui up catalog-ui).
CATALOG_UI_PORT=8080
# Smart classifier leg (Iter 26): empty model keeps the smart ids
# failing closed in dev (no stored key ever — the leg uses the
# caller's Authorization header). The rest are the code defaults,
# explicit here; see .env.example for detail.
CLASSIFIER_MODEL=
CLASSIFIER_BASE_URL=https://openrouter.ai/api
CLASSIFIER_TIMEOUT_MS=8000
CLASSIFIER_FALLBACK_TIER=low
CLASSIFIER_MAX_TOKENS=64
CLASSIFIER_MAX_INPUT_CHARS=32000
# Docker network of the front reverse proxy (Nginx Proxy Manager):
# the server stack joins it so the proxy reaches gateway:8080 and
# catalog-ui:8080 with no published ports. Must already exist on the
# host (it belongs to the proxy stack). Local dev ignores it.
PROXY_NETWORK=caddy_default