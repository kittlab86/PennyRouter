# Deploy script settings — copy to `.env.deploy` and adjust:
#   cp .env.deploy.sample .env.deploy
# Never commit `.env.deploy` (gitignored: it holds hosts/URLs and may
# hold tokens). Both scripts load it automatically when present;
# explicit environment still wins over file values. One `KEY=value`
# per line, `#` comments and blank lines allowed, no inline comments,
# no shell expansion (use full paths, not `~`).
#   scripts/deploy.sh          scp the stack to a server
#   scripts/deploy-webhook.sh  POST a redeploy hook

# --- scripts/deploy.sh (scp deploy) ---
# ssh target.
DEPLOY_HOST=apps.lan
# Remote directory for compose.yaml + .env.
DEPLOY_DIR=/opt/stacks/pennyrouter
# Local compose file to ship (must be pull-only, no build:).
COMPOSE_FILE=compose.dev.yaml
# Name on the server (plain `docker compose` finds compose.yaml).
REMOTE_COMPOSE=compose.yaml
# Base env + secrets overlay default to the repo-root .env.dev and
# .env (DEPLOY_ENV_FILE / DEPLOY_SECRETS_FILE override them).
# Extra ssh/scp options, e.g. "-i /home/user/.ssh/id -p 2222".
SSH_OPTS=
# 1 = print what would run (env redacted) without touching the server.
DRY_RUN=0

# --- scripts/deploy-webhook.sh (generic redeploy hook) ---
# Full endpoint URL.
DEPLOY_URL=http://srv.lan/api/stacks/pennyrouter/sync
# Optional bearer token (empty = no Authorization header is sent).
DEPLOY_API_TOKEN=
# JSON request body.
DEPLOY_PAYLOAD={"pull":true,"forceRecreate":true}
# Max seconds for the call.
DEPLOY_TIMEOUT=60
